{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakecore:schema:ui-runtime:error:v1",
  "title": "UI Runtime protocol v1: error envelope",
  "description": "Every non-2xx response. `retryable` says whether the same request may succeed later unchanged. Never echoes request bodies, cookies or keys.",
  "type": "object", "additionalProperties": false, "required": ["error"],
  "properties": {
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"enum": [
          "unauthorised", "not_found", "method_not_allowed", "bad_body", "payload_too_large", "invalid_request",
          "invalid_session_ref", "idempotency_key_reused", "model_egress_mismatch", "act_not_found", "session_not_found", "runtime_timeout",
          "internal"
        ]},
        "message": {"type": "string", "maxLength": 1000},
        "retryable": {"type": "boolean"},
        "details": {"type": "object"}
      }
    }
  }
}
