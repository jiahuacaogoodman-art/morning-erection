{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakecore:schema:desktop-runtime:act:v1",
  "title": "POST /v1/act",
  "description": "Guarded model loop over one app (the hand), acting on accessibility elements by index. At most once per `key`: a repeat returns the journalled result (`deduplicated: true`); the same key with a different request (app, apps, goal) is 409 idempotency_key_reused. `completed` is only the model's claim: clients MUST verify with a fresh observation.",
  "$ref": "#/$defs/request",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "app",
        "apps",
        "goal"
      ],
      "properties": {
        "key": {
          "$ref": "common.v1.schema.json#/$defs/act_key"
        },
        "attempt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "app": {
          "$ref": "common.v1.schema.json#/$defs/bundle_id"
        },
        "apps": {
          "$ref": "common.v1.schema.json#/$defs/apps"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "timeout_s": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "model_egress": {
          "type": "string",
          "pattern": "^model:",
          "maxLength": 300,
          "description": "the model egress the caller's approval covers; a different one is 409 model_egress_mismatch before anything is sent. Not part of the request digest."
        }
      }
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "needs_human",
        "refused",
        "model_error",
        "error",
        "canceled",
        "in_progress",
        "interrupted"
      ]
    },
    "response": {
      "type": "object",
      "required": [
        "status",
        "mutating_actions"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "reason": {
          "type": "string"
        },
        "action_space": {
          "const": "wakecore.desktop-ax/1"
        },
        "app": {
          "type": "string"
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "actions_executed": {
          "type": "integer",
          "minimum": 0
        },
        "mutating_actions": {
          "type": "integer",
          "minimum": 0,
          "description": "actions that may have reached the app (journalled before they were sent)"
        },
        "blocked_actions": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "final_window": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "usage": {
          "$ref": "common.v1.schema.json#/$defs/usage"
        },
        "model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "model_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "error_detail": {
          "type": "string"
        },
        "artifacts_ref": {
          "type": "string"
        },
        "deduplicated": {
          "type": "boolean"
        },
        "journal_status": {
          "enum": [
            "in_progress",
            "finished",
            "interrupted"
          ]
        }
      }
    },
    "status_response": {
      "type": "object",
      "required": [
        "status",
        "mutating_actions"
      ],
      "properties": {
        "status": {
          "enum": [
            "never_received",
            "in_progress",
            "finished",
            "interrupted"
          ]
        },
        "mutating_actions": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cancel_response": {
      "type": "object",
      "required": [
        "key",
        "cancel_requested",
        "status"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "queued",
            "in_progress",
            "finished",
            "interrupted"
          ]
        }
      }
    }
  }
}
