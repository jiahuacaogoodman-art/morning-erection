{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakecore:schema:desktop-runtime:act-record:v1",
  "title": "GET /v1/acts/{key}",
  "description": "The journal record of one act key: which kinds of actions were sent (never typed text), which were refused, the result and the evidence files.",
  "type": "object",
  "required": [
    "key",
    "status",
    "attempt",
    "started_at",
    "mutating",
    "blocked",
    "history",
    "artifacts"
  ],
  "properties": {
    "key": {
      "type": "string"
    },
    "attempt": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "the app's bundle ID"
    },
    "status": {
      "enum": [
        "in_progress",
        "finished",
        "interrupted"
      ]
    },
    "started_at": {
      "type": "number"
    },
    "finished_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "cancel_requested_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "request_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "mutating": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/action_log_entry"
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "$ref": "common.v1.schema.json#/$defs/action_log_entry"
      }
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "act.v1.schema.json#/$defs/response"
        }
      ]
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "screenshots"
      ],
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^step-[0-9]{3}\\.(png|jpg)$"
          }
        }
      }
    }
  }
}
