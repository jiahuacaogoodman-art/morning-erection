{
  "components": {
    "schemas": {
      "api_error.v1": {
        "additionalProperties": false,
        "description": "Every non-2xx response. Never echoes tokens or request bodies. trace_id is also sent as X-Trace-Id.",
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "KERNEL_ERROR",
                  "NOT_FOUND",
                  "TASK_NOT_ACTIVE",
                  "TASK_EXPIRED",
                  "SOURCE_AUTH_REQUIRED",
                  "SOURCE_COVERAGE_INSUFFICIENT",
                  "SCHEMA_MISMATCH",
                  "POLICY_DENIED",
                  "APPROVAL_REQUIRED",
                  "APPROVAL_STALE",
                  "BUDGET_DEFERRED",
                  "STALE_LEASE",
                  "SIDE_EFFECT_UNKNOWN",
                  "VERSION_CONFLICT",
                  "INVALID_TRANSITION",
                  "IDEMPOTENCY_CONFLICT",
                  "IDENTITY_CONFLICT",
                  "UNAUTHENTICATED",
                  "METHOD_NOT_ALLOWED",
                  "PAYLOAD_TOO_LARGE",
                  "INTERNAL"
                ]
              },
              "details": {
                "type": "object"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "trace_id": {
                "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "retryable",
              "details",
              "trace_id"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "title": "WakeCore API error (RFC §15)",
        "type": "object"
      },
      "event_envelope.v1": {
        "description": "Body of POST /v1/ingress/{source_ref}, authenticated by X-WakeCore-Signature (HMAC-SHA256 of the raw body with the binding's ingress secret). source must equal the binding's source_uri; types starting with 'wakecore.' are reserved. Unsupported data.schema_version is quarantined, not rejected. Mirrors wakecore/kernel/events/admission.py.",
        "properties": {
          "data": {
            "properties": {
              "schema_version": {
                "type": "integer"
              }
            },
            "type": "object"
          },
          "datacontenttype": {
            "type": "string"
          },
          "id": {
            "description": "Deduplicated per (tenant, source_ref).",
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "specversion": {
            "const": "1.0"
          },
          "subject": {
            "type": "string"
          },
          "time": {
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "minLength": 1,
            "not": {
              "pattern": "^wakecore\\."
            },
            "type": "string"
          }
        },
        "required": [
          "specversion",
          "id",
          "source",
          "type"
        ],
        "title": "WakeCore ingress event (CloudEvents 1.0 structured JSON, RFC §6)",
        "type": "object"
      },
      "task_spec.v1": {
        "additionalProperties": false,
        "description": "Mirrors wakecore/kernel/domain/taskspec.py:parse_task_spec. The parser is authoritative; unknown fields are rejected at every level. tenant_id is taken from the authenticated principal and may be omitted.",
        "properties": {
          "accounting_timezone": {
            "type": "string"
          },
          "authority": {
            "additionalProperties": false,
            "description": "A request only: effective authority is the intersection with the grant and system policy (RFC §7).",
            "properties": {
              "grant_ref": {
                "type": "string"
              },
              "model_data_egress": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "notify_capabilities": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "read_capabilities": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "write_capabilities": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "grant_ref"
            ],
            "type": "object"
          },
          "completion": {
            "additionalProperties": false,
            "properties": {
              "evaluator": {
                "type": "string"
              },
              "evaluator_version": {
                "minimum": 1,
                "type": "integer"
              },
              "required_outputs": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "evaluator"
            ],
            "type": "object"
          },
          "decision": {
            "additionalProperties": false,
            "description": "V0.3: decision profile that interprets observations. Absent means grades.v1. Profile parameters are validated by the kernel profile registry (wakecore/kernel/decision/profiles.py).",
            "properties": {
              "params": {
                "description": "generic_watch.v1: conditions[{field,op,value,kind}], watch_fields[], on_met notify|plan, label_field, complete_when[], title",
                "type": "object"
              },
              "profile": {
                "enum": [
                  "grades.v1",
                  "generic_watch.v1"
                ],
                "type": "string"
              }
            },
            "required": [
              "profile"
            ],
            "type": "object"
          },
          "depth": {
            "minimum": 0,
            "type": "integer"
          },
          "expires_at": {
            "description": "Must carry a timezone offset.",
            "format": "date-time",
            "type": "string"
          },
          "followup": {
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "limits": {
            "additionalProperties": false,
            "properties": {
              "max_followup_count": {
                "minimum": 0,
                "type": "integer"
              },
              "max_followup_depth": {
                "minimum": 0,
                "type": "integer"
              },
              "max_model_attempts_per_day": {
                "minimum": 0,
                "type": "integer"
              },
              "max_run_seconds": {
                "minimum": 0,
                "type": "integer"
              },
              "max_steps_per_run": {
                "minimum": 0,
                "type": "integer"
              },
              "min_probe_interval_seconds": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "observation": {
            "additionalProperties": false,
            "properties": {
              "completeness_required": {
                "enum": [
                  "full_target_scope",
                  "declared_scope"
                ]
              },
              "first_snapshot": {
                "enum": [
                  "notify_existing_results",
                  "baseline_only"
                ]
              },
              "ignore_fields": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "target_key": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "parent_task_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "root_task_id": {
            "minLength": 1,
            "type": "string"
          },
          "schema_version": {
            "const": 1
          },
          "source": {
            "additionalProperties": false,
            "properties": {
              "binding_ref": {
                "type": "string"
              },
              "resource_scope": {
                "type": "object"
              }
            },
            "required": [
              "binding_ref"
            ],
            "type": "object"
          },
          "spec_version": {
            "minimum": 1,
            "type": "integer"
          },
          "task_id": {
            "minLength": 1,
            "type": "string"
          },
          "tenant_id": {
            "minLength": 1,
            "type": "string"
          },
          "trigger": {
            "additionalProperties": false,
            "description": "interval requires every_seconds >= limits.min_probe_interval_seconds; once requires due_at.",
            "properties": {
              "catchup_policy": {
                "enum": [
                  "coalesce_latest",
                  "skip_missed"
                ]
              },
              "due_at": {
                "format": "date-time",
                "type": "string"
              },
              "every_seconds": {
                "minimum": 1,
                "type": "integer"
              },
              "kind": {
                "enum": [
                  "interval",
                  "once"
                ]
              },
              "timezone": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        },
        "required": [
          "schema_version",
          "task_id",
          "source",
          "trigger",
          "completion",
          "authority",
          "expires_at"
        ],
        "title": "WakeCore TaskSpec v1 (RFC §4.1)",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
